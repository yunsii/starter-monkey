{
  "name": "starter-monkey",
  "type": "module",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "description": "Starter template for userscript engine like Tampermonkey and Violentmonkey, Greasemonkey, ScriptCat, powered by vite-plugin-monkey.",
  "imports": {
    "#tailwind-config.css": "./src/components/inline-tailwindcss/tailwind-config.css",
    "#tailwind-iconify.ts": "./scripts/tailwind-plugins/iconify/index.ts"
  },
  "scripts": {
    "dev": "vite",
    "dev:force": "vite --force",
    "build": "vite build",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "verify": "node scripts/tampermonkey-cdp.mjs",
    "release": "bumpp"
  },
  "dependencies": {
    "@1natsu/wait-element": "^4.2.0",
    "@ant-design/cssinjs": "^2.1.2",
    "@monaco-editor/react": "^4.7.0",
    "@webext-core/isolated-element": "^1.1.5",
    "antd": "^6.6.0",
    "browser-extension-url-match": "^1.2.0",
    "es-toolkit": "^1.50.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dx": "^1.1.1",
    "tagged-classnames-free": "^0.1.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/types": "^19.8.1",
    "@eslint-react/eslint-plugin": "^1.53.1",
    "@iconify-json/bx": "^1.2.3",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@jannajs/lint": "^3.1.4",
    "@prettier/plugin-xml": "^3.4.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "bumpp": "^12.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-format": "^1.5.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-plugin-iconify": "^2.1.0",
    "type-fest": "^5.8.0",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^21.1.0",
    "vite": "^8.2.1",
    "vite-plugin-monkey": "^8.1.0",
    "zx": "^8.8.5"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
